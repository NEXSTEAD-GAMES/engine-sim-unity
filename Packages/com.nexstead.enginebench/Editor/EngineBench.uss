:root {
    --instrument-bg: #1b1e25;
    --instrument-raised: #2a2f3a;
    --instrument-text: #e8eaed;
    --instrument-dim: #9aa0a6;
    --accent: #38d3b0;
    --caution: #ffb020;
    --danger: #ff4d4d;
}

.bench {
    flex-grow: 1;
}

.bench__toolbar {
    flex-shrink: 0;
}

.bench__engine-menu {
    min-width: 260px;
    -unity-text-align: middle-left;
}

.save-button {
    background-color: #d29922;
    color: #121418;
    -unity-font-style: bold;
}

.save-button:hover {
    background-color: #e3b341;
}

.bench__spacer {
    flex-grow: 1;
}

.bench__body {
    flex-direction: row;
    flex-grow: 1;
}

.bench__left {
    width: 380px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.25);
}

.bench__main {
    flex-grow: 1;
}

.bench__stage {
    flex-direction: row;
    flex-grow: 1;
}

.bench__traces {
    flex-direction: row;
    flex-shrink: 0;
    height: 190px;
    margin: 4px 4px 8px 4px;
}

.bench__section {
    padding: 8px;
}

.bench__section--hidden {
    display: none;
}

.bench__hint {
    white-space: normal;
    margin: 8px;
}

.bench__caption {
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 2px;
    margin-left: 3px;
}

.bench__row {
    flex-direction: row;
}

.bench__row > .unity-button {
    flex-grow: 1;
}


.tuned-value {
    flex-direction: row;
    align-items: center;
}

.tuned-value__tick {
    margin-right: 2px;
}

.tuned-value__slider {
    flex-grow: 1;
    flex-shrink: 1;
}

.instrument {
    width: 300px;
    flex-shrink: 0;
    background-color: var(--instrument-bg);
    border-radius: 6px;
    margin: 8px 8px 4px 8px;
}

.instrument .unity-scroll-view__content-container {
    padding: 12px 16px;
}

.instrument__title {
    color: var(--instrument-text);
    font-size: 20px;
    -unity-font-style: bold;
}

.instrument__subtitle {
    color: var(--instrument-dim);
    margin-bottom: 10px;
}

.instrument__caption {
    color: var(--instrument-dim);
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.engine-view {
    flex-grow: 1;
    background-color: var(--instrument-bg);
    border-radius: 6px;
    margin: 8px 0 4px 8px;
    padding-bottom: 84px;
}

.run-controls {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    padding: 6px 8px;
    background-color: rgba(42, 47, 58, 0.9);
    border-radius: 6px;
}

.run-controls__row {
    flex-direction: row;
    align-items: center;
}

.run-controls__inputs {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    margin-left: 8px;
}

.run-controls__inputs > .unity-slider {
    flex-grow: 1;
    flex-basis: 0;
}

.run-controls .unity-base-field__label {
    min-width: 58px;
    color: var(--instrument-text);
}

.run-controls__dyno {
    margin-right: 14px;
}

.run-controls__dyno .unity-toggle__text {
    margin-left: 4px;
    color: var(--instrument-text);
}

.run-controls__inputs > .run-controls__volume {
    flex-grow: 0;
    flex-basis: 170px;
}

.start-button {
    width: 96px;
    height: 34px;
    margin: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: #2ea043;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
}

.start-button:hover {
    background-color: #3fb950;
}

.start-button--running {
    background-color: #da3633;
}

.start-button--running:hover {
    background-color: #f85149;
}

.run-controls__notice {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.run-controls__notice-text {
    flex-grow: 1;
    color: var(--caution);
}

.engine-view__caption {
    position: absolute;
    left: 10px;
    top: 8px;
    color: var(--instrument-dim);
    font-size: 11px;
}

.tach {
    height: 220px;
    margin-top: 4px;
}

.tach__rpm {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    -unity-text-align: middle-center;
    color: var(--instrument-text);
    font-size: 34px;
    -unity-font-style: bold;
}

.tach__rpm--over {
    color: var(--danger);
}

.tach__unit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    -unity-text-align: middle-center;
    color: var(--instrument-dim);
    font-size: 10px;
}

.cylinder-lights {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.cylinder-lamp {
    width: 26px;
    height: 26px;
    margin: 0 4px 4px 0;
    justify-content: center;
}

.cylinder-lamp__number {
    -unity-text-align: middle-center;
    color: var(--instrument-dim);
    font-size: 10px;
    -unity-font-style: bold;
}

.cylinder-lamp--lit > .cylinder-lamp__number {
    color: #121418;
}

.trace-panel {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--instrument-bg);
    border-radius: 6px;
    margin: 0 4px;
    padding: 4px 10px 8px 10px;
}

.trace-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.trace-panel__button {
    margin: 0;
    padding: 0 10px;
    height: 18px;
}

.trace-view {
    flex-grow: 1;
    margin-top: 4px;
}

.readout {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--instrument-raised);
}

.readout__name {
    color: var(--instrument-dim);
}

.readout__value {
    color: var(--instrument-text);
    -unity-font-style: bold;
}

.value--good {
    color: var(--accent);
}

.value--caution {
    color: var(--caution);
}

.value--danger {
    color: var(--danger);
}

.instrument__failure {
    color: var(--danger);
    white-space: normal;
    margin-top: 8px;
}

.design__figures {
    white-space: normal;
    margin: 4px 3px 6px 3px;
    color: var(--instrument-dim);
}

.design__advanced {
    margin-top: 10px;
}

.design__range .unity-base-slider__text-field {
    width: 64px;
}

.design__row {
    flex-direction: row;
    align-items: center;
}

.design__row-name {
    width: 52px;
    flex-shrink: 0;
    color: var(--instrument-dim);
}

.design__cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 40px;
}

.export .unity-base-field__label {
    min-width: 56px;
}

.export-card {
    margin-bottom: 10px;
    padding: 10px 12px 12px 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.3);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.12);
}

.export-card--soon {
    padding-bottom: 10px;
    opacity: 0.6;
}

.export-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.export-card__title {
    flex-shrink: 1;
    white-space: normal;
    font-size: 14px;
    -unity-font-style: bold;
}

.export-badge {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 2px 6px;
    border-radius: 8px;
    background-color: rgba(128, 128, 128, 0.35);
    font-size: 10px;
    -unity-font-style: bold;
}

.export-badge--accent {
    background-color: var(--accent);
    color: #121418;
}

.export-card__text {
    margin-top: 6px;
    white-space: normal;
}

.export-card__text--tagline {
    margin-top: 2px;
    opacity: 0.75;
}

.export-card__text--note {
    font-size: 11px;
    opacity: 0.75;
}

.export-card__item {
    flex-direction: row;
    margin-top: 3px;
}

.export-card__bullet {
    width: 12px;
    flex-shrink: 0;
    color: var(--accent);
    -unity-font-style: bold;
}

.export-card__item-text {
    flex-shrink: 1;
    white-space: normal;
}

.export-card__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.export-status__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--instrument-dim);
}

.export-status__dot--on {
    background-color: var(--accent);
}

.export-status {
    flex-grow: 1;
    margin-left: 6px;
}

.export-button {
    height: 26px;
    margin: 0;
    padding: 0 12px;
    border-radius: 4px;
}

.export-button--primary {
    border-width: 0;
    background-color: var(--accent);
    color: #121418;
    -unity-font-style: bold;
}

.export-button--primary:hover {
    background-color: #5ee0c2;
}

.export-button--wide {
    margin-top: 10px;
}

.export__folder-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.export__folder {
    flex-grow: 1;
    flex-shrink: 1;
}

.export__choose {
    flex-shrink: 0;
}

.export-result {
    margin-top: 8px;
    padding: 8px;
    border-left-width: 3px;
    border-left-color: var(--accent);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.15);
}

.export-result--warning {
    border-left-color: var(--caution);
}

.export-result__text {
    white-space: normal;
}

.export-result > .export-button {
    align-self: flex-start;
    margin-top: 8px;
}

.export-heading {
    margin: 6px 0 6px 2px;
    font-size: 11px;
    -unity-font-style: bold;
    opacity: 0.7;
}
